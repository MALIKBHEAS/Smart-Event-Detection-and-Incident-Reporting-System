# Base path prepended to every API call (see src/api/client.ts).
# Defaults to "/api", which vite.config.ts's dev proxy rewrites to the
# FastAPI backend (VITE_BACKEND_ORIGIN, default http://localhost:8000).
# In production, point this at wherever the backend is reverse-proxied,
# or leave as "/api" if your prod server does the same proxy/rewrite.
VITE_API_BASE_URL=/api

# Only used by the Vite dev server proxy (see vite.config.ts) -- not read
# by the frontend app itself.
VITE_BACKEND_ORIGIN=http://localhost:8000
